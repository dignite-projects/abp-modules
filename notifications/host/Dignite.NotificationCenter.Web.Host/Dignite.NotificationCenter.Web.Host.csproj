<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Common settings (LangVersion, Version, NoWarn, AbpProjectType, Razor NoWarn target) come from
       Directory.Build.props in this folder, which MSBuild imports automatically. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Local-dev-only demo host: kept in the .slnx for one-click run/debug, but never packed/published. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Security overrides for vulnerable transitive dependencies: this host pins its own inline versions
    (it opts out of the repo-root central package management), so a direct PackageReference is how it
    would force a patched version. None is needed at ABP 10.7.0 - the ABP 10.5-era overrides were dropped
    because the 10.7.0 graph already resolves a patched version of each:
      MessagePack                   3.1.7  (GHSA-hv8m-jj95-wg3x et al.; Volo.Abp.Studio.Client.AspNetCore 3.1.4 -> MagicOnion 7.10.2)
      Microsoft.OpenApi             2.7.5  (GHSA-v5pm-xwqc-g5wc; Volo.Abp.Swashbuckle 10.7.0 -> Swashbuckle.AspNetCore 10.2.3)
      Scriban                       7.2.5  (GHSA-7jvp-hj45-2f2m; Volo.Abp.TextTemplating.Scriban 10.7.0)
      SQLitePCLRaw.bundle_e_sqlite3 2.1.12 (GHSA-2m69-gcr7-jv3q; Microsoft.EntityFrameworkCore.Sqlite 10.0.11)
    Microsoft.OpenApi must stay on 2.x if it is ever pinned again: Swashbuckle.AspNetCore 10.2.3 is built
    against Microsoft.OpenApi 2.x, and 3.0 is a breaking major (dependabot ignores >= 3.0.0).
  -->

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.12" />
    <PackageReference Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageReference Include="KubernetesClient" Version="19.0.2"/>
    <PackageReference Include="IdentityModel" Version="7.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Mapperly" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Account.HttpApi" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Account.Application" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.Identity" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Identity.HttpApi" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Identity.Application" Version="10.7.0" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Volo.Abp.PermissionManagement.Domain.OpenIddict" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Web" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.HttpApi" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Application" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.FeatureManagement.HttpApi" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Application" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.SettingManagement.HttpApi" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.Application" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AuditLogging.EntityFrameworkCore" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.Identity.EntityFrameworkCore" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.OpenIddict.EntityFrameworkCore" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.BackgroundJobs.EntityFrameworkCore" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.BlobStoring.Database.EntityFrameworkCore" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.EntityFrameworkCore" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.EntityFrameworkCore" Version="10.7.0" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="10.7.0" />
  </ItemGroup>

  <!--
    Volo.Abp.Studio.Client.AspNetCore has its own version line and declares a minimum Volo.Abp.AspNetCore.
    3.1.4 (minimum 10.6.1) is the newest release whose minimum does not exceed this host's ABP 10.7.0; no
    release requires exactly 10.7.0 yet. A later one that requires an ABP version above 10.7.0 would pull
    the rest of the host up with it (NU1605), hence the dependabot ignore on >= 3.1.5.
  -->
  <ItemGroup>
    <PackageReference Include="Volo.Abp.Studio.Client.AspNetCore" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>compile; contentFiles; build; buildMultitargeting; buildTransitive; analyzers; native</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>compile; contentFiles; build; buildMultitargeting; buildTransitive; analyzers; native</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup Condition="Exists('./openiddict.pfx')">
    <None Remove="openiddict.pfx" />
    <EmbeddedResource Include="openiddict.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Localization\Host\*.json" />
    <EmbeddedResource Include="Localization\Host\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="**\*.abppkg" />
    <None Remove="**\*.abppkg.analyze.json" />
    <Content Remove="$(UserProfile)\.nuget\packages\*\*\contentFiles\any\*\*.abppkg*" />
  </ItemGroup>

  <ItemGroup Label="Dignite.Abp.Notifications / NotificationCenter (this repo, project references)">
    <ProjectReference Include="..\..\notification-center\src\Dignite.NotificationCenter.Web\Dignite.NotificationCenter.Web.csproj" />
    <ProjectReference Include="..\..\notification-center\src\Dignite.NotificationCenter.Application\Dignite.NotificationCenter.Application.csproj" />
    <ProjectReference Include="..\..\notification-center\src\Dignite.NotificationCenter.HttpApi\Dignite.NotificationCenter.HttpApi.csproj" />
    <ProjectReference Include="..\..\notification-center\src\Dignite.NotificationCenter.EntityFrameworkCore\Dignite.NotificationCenter.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\core\src\Dignite.Abp.Notifications\Dignite.Abp.Notifications.csproj" />
    <ProjectReference Include="..\..\core\src\Dignite.Abp.Notifications.EntityFrameworkCore\Dignite.Abp.Notifications.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\core\src\Dignite.Abp.Notifications.SignalR\Dignite.Abp.Notifications.SignalR.csproj" />
    <ProjectReference Include="..\..\core\src\Dignite.Abp.Notifications.Identity\Dignite.Abp.Notifications.Identity.csproj" />
  </ItemGroup>

</Project>
