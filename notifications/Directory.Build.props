<Project>

  <!-- MSBuild imports only the NEAREST Directory.Build.props per project and stops walking up, so
       this file must explicitly import the repo root's to inherit the lockstep <Version> /
       <AssemblyVersion> / shared metadata. See MIGRATION.md Phase 3.
       (host/Dignite.NotificationCenter.Web.Host/ has its own nearer Directory.Build.props and is
       intentionally isolated from this chain - see the comment there.) -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Product>Dignite Abp Notifications</Product>
    <PackageTags>abp;notifications;notification-center;signalr;real-time;aspnetcore</PackageTags>
  </PropertyGroup>

  <!-- TODO(Phase 6): once README.md/CONTRIBUTING.md/SECURITY.md merge to the repo root, delete this
       ItemGroup and let the root Directory.Build.props pack the single root README.md/icon.png for
       every package instead. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory).github\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
