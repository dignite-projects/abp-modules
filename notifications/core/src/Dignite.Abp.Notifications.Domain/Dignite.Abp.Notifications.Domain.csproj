<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <Description>The notification definition store of Dignite.Abp.Notifications, after ABP's permission management domain (dynamic permission and feature stores): every process saves the definitions its business modules register to shared tables, and a process that hosts no business module (a dedicated notification service) reads them from there. Add Dignite.Abp.Notifications.EntityFrameworkCore for the tables.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polly" />
    <PackageReference Include="Volo.Abp.Ddd.Domain" />
    <PackageReference Include="Volo.Abp.DistributedLocking.Abstractions" />
    <PackageReference Include="Volo.Abp.Localization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dignite.Abp.Notifications.Abstractions\Dignite.Abp.Notifications.Abstractions.csproj" />
    <ProjectReference Include="..\Dignite.Abp.Notifications.Domain.Shared\Dignite.Abp.Notifications.Domain.Shared.csproj" />
  </ItemGroup>

</Project>
