<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <RootNamespace />
    <Description>The contracts of Dignite.Abp.Notifications: notification definitions and routing, INotificationPublisher, the payload types ([NotificationDataType], NotificationData), NotificationDeliveryRequestedEto and NotificationPublishRequestedEto, INotificationNotifier, and the INotificationStore / INotificationDistributor / INotificationPermissionChecker contracts. Business modules and notifiers depend on only this package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Volo.Abp.Features" />
    <PackageReference Include="Volo.Abp.Localization" />
    <PackageReference Include="Volo.Abp.EventBus.Abstractions" />
    <PackageReference Include="Volo.Abp.MultiTenancy.Abstractions" />
    <PackageReference Include="Volo.Abp.Json.SystemTextJson" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dignite.Abp.Notifications.Tests" />
  </ItemGroup>

</Project>
