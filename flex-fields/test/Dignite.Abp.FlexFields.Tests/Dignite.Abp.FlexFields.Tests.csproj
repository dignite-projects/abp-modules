<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Volo.Abp.TestBase" />
    <PackageReference Include="Volo.Abp.Autofac" />
  </ItemGroup>

  <!-- Abstractions only, deliberately: these tests double as the proof that a downstream needs nothing
       but this package to get the field types, the resolver and localization. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Dignite.Abp.FlexFields.Abstractions\Dignite.Abp.FlexFields.Abstractions.csproj" />
  </ItemGroup>

  <!-- The one exception, for FieldConfigurationValidator_Tests: the CKEditor bolt-on declares configuration
       keys like the built-ins and has no test project of its own. It is referenced, never made a module
       dependency, so its field type is not registered here - and it references Abstractions only itself. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Dignite.Abp.FlexFields.CKEditor\Dignite.Abp.FlexFields.CKEditor.csproj" />
  </ItemGroup>

</Project>
