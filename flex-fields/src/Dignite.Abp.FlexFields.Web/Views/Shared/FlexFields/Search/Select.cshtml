@using Dignite.Abp.FlexFields.Select
@model Dignite.Abp.FlexFields.Web.FlexFieldSearchViewModel
@{
    var config = new SelectConfiguration(Model.Field.Configuration);
}
<select class="flex-field-search flex-field-search-select"
        name="@Model.Name"
        multiple="@config.Multiple"
        data-field-type="@Model.Field.FieldTypeName"
        aria-label="@Model.Field.DisplayName">
    @foreach (var option in config.Options)
    {
        <option value="@option.Value">@option.Text</option>
    }
</select>
