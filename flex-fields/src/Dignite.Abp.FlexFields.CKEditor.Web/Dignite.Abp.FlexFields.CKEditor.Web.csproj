<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Description>Default &lt;flex-field-view&gt; rendering (Dignite.Abp.FlexFields.Web) for the CKEditor bolt-on field type: converts a Markdown-format value to HTML (Markdig, GFM-compatible pipeline) and sanitizes the result (HtmlSanitizer) before rendering - see FlexFieldsCKEditorWebModule for the sanitizer/pipeline setup. No search partial: CKEditorFieldType.IndexValueType is null, so there is nothing to search on.</Description>
  </PropertyGroup>

  <!-- See Dignite.Abp.FlexFields.Web's csproj comment - the Razor SDK's default @(RazorGenerate) glob
       did not pick up Views/**/*.cshtml on its own in this repo. -->
  <ItemGroup>
    <RazorGenerate Include="Views\**\*.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dignite.Abp.FlexFields.CKEditor\Dignite.Abp.FlexFields.CKEditor.csproj" />
    <ProjectReference Include="..\Dignite.Abp.FlexFields.Web\Dignite.Abp.FlexFields.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="HtmlSanitizer" />
  </ItemGroup>

</Project>
