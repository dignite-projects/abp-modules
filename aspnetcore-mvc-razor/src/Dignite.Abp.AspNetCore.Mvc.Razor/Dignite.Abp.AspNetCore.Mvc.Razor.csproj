<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Description>Generic ASP.NET Core MVC/Razor infrastructure for ABP Framework solutions: IRazorPartialRenderer (render a partial view + model to an HTML string outside a controller action) and TenantViewLocationExpander (resolve Razor views per tenant, then per theme, before falling back to the host's default). Domain-agnostic - not owned by, and does not reference, any module in this repository.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI" />
  </ItemGroup>

</Project>
