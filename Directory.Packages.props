<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the security pins below override versions that ABP / EF Core resolve transitively. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Security pins for vulnerable transitive dependencies. Microsoft.EntityFrameworkCore.Sqlite
    (via Volo.Abp.EntityFrameworkCore.Sqlite 10.5.0) still bundles SQLitePCLRaw 2.1.11, which
    ships a SQLite older than 3.50.2 (GHSA-2m69-gcr7-jv3q / CVE-2025-6965). 2.1.12 is the first
    build past that advisory; pin the whole family so they stay on one version. Remove once the
    EF Core SQLite provider rolls its bundle forward on its own. (Carried over from
    abp-file-storing; abp-notifications had no equivalent pin.)
  -->
  <ItemGroup Label="Security-patched transitive dependencies">
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup Label="ABP 10.5.0">
    <PackageVersion Include="Volo.Abp.Core" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.BlobStoring" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Validation" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Imaging.Abstractions" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Imaging.ImageSharp" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Domain" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Application" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Ddd.Application.Contracts" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Authorization" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Authorization.Abstractions" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.Mvc" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.Mvc.UI" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Http.Client" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Mapperly" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.MongoDB" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Autofac" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.TestBase" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.VirtualFileSystem" Version="10.5.0" />
    <!-- notifications-only -->
    <PackageVersion Include="Volo.Abp.Localization" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Domain" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Features" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Timing" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Guids" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.EventBus" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.EventBus.Abstractions" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.MultiTenancy.Abstractions" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Abstractions" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.BackgroundWorkers" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.DistributedLocking.Abstractions" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.SignalR" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Json.SystemTextJson" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.Mvc.UI.Bundling" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Web" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Identity.Domain" Version="10.5.0" />
    <PackageVersion Include="Volo.Abp.Emailing" Version="10.5.0" />
  </ItemGroup>

  <!--
    Microsoft.Extensions.FileProviders.Embedded: referenced both here (for the centrally-managed
    library projects) and inline by all 3 host/demo apps, which opt out of central management -
    dependabot's per-directory PRs only bump one of those four spots at a time, so keep all four in
    lockstep by hand or the solution-wide restore hits NU1605 (downgrade) across modules. notifications
    needs this as a direct reference (not just ABP's transitive one) to activate its build-time
    manifest generation for embedded wwwroot content (ABP's AddEmbedded/ManifestEmbeddedFileProvider).
  -->
  <ItemGroup Label="Embedded static and localization resources">
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="System.Text.Json (only needed for netstandard targets; in-box on net10.0)">
    <PackageVersion Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Microsoft hosting abstractions">
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="MongoDB integration-test infrastructure (embedded mongod, ABP v10 pattern)">
    <PackageVersion Include="MongoSandbox.Core" Version="2.0.0" />
    <PackageVersion Include="MongoSandbox8.runtime.win-x64" Version="2.0.0" />
    <PackageVersion Include="MongoSandbox8.runtime.linux-x64" Version="2.0.0" />
    <PackageVersion Include="MongoSandbox8.runtime.osx-arm64" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Label="SourceLink">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>

  <!--
    CKEditor bolt-on (Dignite.Abp.FlexFields.CKEditor.Web only): Markdig converts a Markdown-format
    field value to HTML server-side before rendering (see FlexFieldsCKEditorWebModule, which builds the
    pipeline with .UseAdvancedExtensions() for GFM support - CKEditor 5's Markdown plugin emits GitHub
    Flavored Markdown, not bare CommonMark). HtmlSanitizer (Ganss.Xss) sanitizes the resulting HTML - and
    the HTML-format path's raw value too - before @Html.Raw renders it; this is the first field type in
    the repo that renders stored markup as markup rather than escaped text, so sanitizing server-side
    output is new here, not an existing pattern being extended.
  -->
  <ItemGroup Label="CKEditor bolt-on: Markdown/HTML conversion and sanitization (Dignite.Abp.FlexFields.CKEditor.Web only)">
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
  </ItemGroup>

  <!--
    Build-time-only tooling (all PrivateAssets="all" at the reference site, so none of it flows to
    consumers of the packages):
      - coverlet.collector    : code-coverage collector, added to test projects only
      - Fody / ConfigureAwait.Fody : IL weaver that appends .ConfigureAwait(false) to every await in
        the packable libraries (Release only) - see the repo-root FodyWeavers.xml and
        Directory.Build.props. Versions match what the ABP Framework itself ships.
  -->
  <ItemGroup Label="Build-time tooling">
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Fody" Version="6.9.3" />
    <PackageVersion Include="ConfigureAwait.Fody" Version="3.3.2" />
  </ItemGroup>

</Project>
