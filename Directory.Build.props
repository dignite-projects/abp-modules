<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Lockstep version: one <Version> for every packable project in this repo (all three module
         trees) - see CONTRIBUTING.md#versioning-and-releases. MAJOR tracks the ABP
         Framework major version targeted in Directory.Packages.props (currently 10.5.0 -> MAJOR =
         10) and must stay >= 10 forever, permanently ahead of the legacy Dignite.FileExplorer.* / Dignite.Abp.Notifications*
         package lines already published on NuGet up to 3.8.2 under these same PackageIds. -->
    <Version>10.0.0-rc.7</Version>
    <!-- Pinned explicitly and never bumped in lockstep with <Version>: without this the SDK derives
         AssemblyVersion from <Version>, moving it on every release and breaking
         AssemblyQualifiedName-based lookups. notifications/'s NotificationData deserialization
         depends on this staying 1.0.0.0 - see
         notifications/.claude/skills/notifications-invariants/SKILL.md §1. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <Authors>Dignite</Authors>
    <Company>Dignite</Company>
    <Copyright>© Dignite</Copyright>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dignite-projects/abp-modules</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dignite-projects/abp-modules</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Product / PackageTags are module-specific: file-storing/Directory.Build.props and
       notifications/Directory.Build.props each override them in a thin file that explicitly
       imports this one (MSBuild imports only the NEAREST Directory.Build.props per project and
       stops walking up, so each module needs that explicit import to inherit the settings above). -->

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Test-project detection (name + path based, so it is available this early - the SDK's own
       IsTestProject isn't set until much later). *.Tests run xunit; *.TestBase is shared scenario
       infrastructure with no runner. The three demo hosts have their OWN nested Directory.Build.props
       that does not import this file, so nothing below ever reaches them. -->
  <PropertyGroup>
    <IsTestProject Condition="$(MSBuildProjectFullPath.Contains('test')) and ($(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.TestBase')))">true</IsTestProject>
  </PropertyGroup>

  <!-- Code-coverage collector for test projects only. Enables the "XPlat Code Coverage" data
       collector for `dotnet test` locally and in CI; see codecov.yml. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="coverlet.collector" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <!-- ConfigureAwait.Fody: rewrites every `await` in the packable libraries to
       `.ConfigureAwait(false)` at the IL level, so a consumer that hosts this code on a
       SynchronizationContext (WPF / WinForms / Blazor Server / classic ASP.NET) can't deadlock on
       these modules' async calls. This mirrors the ABP Framework's own libraries.
       Scope: Release only (keeps Debug builds fast) and never test projects. The weaver config is
       supplied inline via the WeaverConfiguration property (Fody's documented alternative to a
       per-project FodyWeavers.xml), so there is exactly one copy of it, right here, and no stray
       FodyWeavers.xml/.xsd files are scattered across the projects. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(IsTestProject)' != 'true'">
    <WeaverConfiguration>
      <Weavers>
        <ConfigureAwait ContinueOnCapturedContext="false" />
      </Weavers>
    </WeaverConfiguration>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(IsTestProject)' != 'true'">
    <PackageReference Include="ConfigureAwait.Fody" PrivateAssets="all" />
    <PackageReference Include="Fody" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

</Project>
