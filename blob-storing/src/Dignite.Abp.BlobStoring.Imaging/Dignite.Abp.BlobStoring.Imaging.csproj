<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <Description>Image resize and compress IBlobPipelineContributors for ABP BlobStoring, on ABP's provider-agnostic imaging abstractions.</Description>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Dignite\Abp\BlobStoring\Imaging\Localization\Resources\*.json" />
    <Content Remove="Dignite\Abp\BlobStoring\Imaging\Localization\Resources\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- ImageHeaderReader is internal; its tests exercise it directly. -->
    <InternalsVisibleTo Include="Dignite.Abp.BlobStoring.Imaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dignite.Abp.BlobStoring.Pipeline\Dignite.Abp.BlobStoring.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Imaging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>

</Project>
