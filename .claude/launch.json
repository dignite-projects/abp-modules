{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flex-fields-angular",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["yarn", "--cwd", "flex-fields/angular", "start"],
      "port": 4200
    },
    {
      "name": "file-storing-angular",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["yarn", "--cwd", "file-storing/angular", "start"],
      "port": 4200
    },
    {
      "name": "file-storing-host",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "file-storing/host/Dignite.FileExplorer.Web.Host"],
      "port": 44390,
      "url": "https://localhost:44390"
    },
    {
      "name": "flex-fields-demo-host",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "flex-fields/demo/Dignite.Abp.FlexFields.Demo"],
      "port": 44330,
      "url": "https://localhost:44330"
    }
  ]
}
