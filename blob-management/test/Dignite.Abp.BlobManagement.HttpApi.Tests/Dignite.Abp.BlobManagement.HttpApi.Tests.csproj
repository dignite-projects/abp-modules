<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace />
    <!-- Program.cs is the WebApplicationFactory entry point; the test SDK must not generate a second one. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Volo.Abp.AspNetCore.TestBase" />
    <PackageReference Include="Volo.Abp.AspNetCore.MultiTenancy" />
    <PackageReference Include="Volo.Abp.Autofac" />
    <PackageReference Include="Volo.Abp.BlobStoring.Memory" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Blob Management as its own service: Application + HttpApi + EF Core ... -->
    <ProjectReference Include="..\..\src\Dignite.Abp.BlobManagement.Application\Dignite.Abp.BlobManagement.Application.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Abp.BlobManagement.HttpApi\Dignite.Abp.BlobManagement.HttpApi.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Abp.BlobManagement.EntityFrameworkCore\Dignite.Abp.BlobManagement.EntityFrameworkCore.csproj" />
    <!-- ... and an application calling it over HTTP: the provider on the C# client proxies. -->
    <ProjectReference Include="..\..\src\Dignite.Abp.BlobManagement.HttpApi.Client\Dignite.Abp.BlobManagement.HttpApi.Client.csproj" />
    <ProjectReference Include="..\..\src\Dignite.Abp.BlobStoring.BlobManagement\Dignite.Abp.BlobStoring.BlobManagement.csproj" />
    <!-- Test files and the shared in-memory BLOB store; none of its modules is loaded. -->
    <ProjectReference Include="..\Dignite.Abp.BlobManagement.Domain.Tests\Dignite.Abp.BlobManagement.Domain.Tests.csproj" />
  </ItemGroup>

</Project>
