<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <Description>Domain layer of Dignite Blob Management: the tenant's BLOB containers, their files and directories, for ABP applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Domain" />
    <!-- The dedup lock (FileDescriptorManager): an upload and a delete of the same bytes take turns. -->
    <PackageReference Include="Volo.Abp.DistributedLocking.Abstractions" />
    <!-- The cleanup of files uploaded through a ticket and never confirmed. -->
    <PackageReference Include="Volo.Abp.BackgroundWorkers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dignite.Abp.BlobManagement.Domain.Shared\Dignite.Abp.BlobManagement.Domain.Shared.csproj" />
    <!-- The declared edge blob-management/ -> blob-storing/ (root CLAUDE.md, invariant 2): Blob Management runs blob-storing's
         pipeline and imaging contributors (the container presets) and its MIME detector. dotnet pack turns them into
         same-version PackageReferences. -->
    <ProjectReference Include="..\..\..\blob-storing\src\Dignite.Abp.BlobStoring.Pipeline\Dignite.Abp.BlobStoring.Pipeline.csproj" />
    <ProjectReference Include="..\..\..\blob-storing\src\Dignite.Abp.BlobStoring.Imaging\Dignite.Abp.BlobStoring.Imaging.csproj" />
    <!-- The images preset stores a JPEG as WebP, turned upright (StoreJpegAsWebp), so SkiaSharp is a dependency of
         Blob Management; the module also makes ABP's SkiaSharp resizer turn photos upright. -->
    <ProjectReference Include="..\..\..\blob-storing\src\Dignite.Abp.BlobStoring.Imaging.SkiaSharp\Dignite.Abp.BlobStoring.Imaging.SkiaSharp.csproj" />
  </ItemGroup>

</Project>
