{
  "BlobManagement": {
    "Containers": {
      "media": {
        "Preset": "Images"
      },
      "attachments": {
        "Preset": "Documents"
      },
      "documents": {
        "AllowDirectories": true,
        "Preset": "Any"
      },
      "shared": {
        "AllowDirectories": true,
        "Preset": "Any"
      }
    }
  },
  "App": {
    "SelfUrl": "https://localhost:44352",
    "ClientUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.Host.com,http://localhost:4200",
    "RedirectAllowedUrls": "http://localhost:4200",
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=../BlobManagementHost.db;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44352",
    "SwaggerClientId": "Host_Swagger",
    "CertificatePassPhrase": "07934b3f-8326-4aa5-bc65-e3ecb94d5b38"
  },
  "Settings": {
    "Abp.Identity.Password.RequireNonAlphanumeric": "false",
    "Abp.Identity.Password.RequireLowercase": "false",
    "Abp.Identity.Password.RequireUppercase": "false",
    "Abp.Identity.Password.RequireDigit": "false"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "EtS7XtEPLBBdrLzh"
  },
  "OpenIddict": {
    "Applications": {
      "Host_App": {
        "ClientId": "Host_App",
        "RootUrl": "http://localhost:4200"
      },
      "Host_BusinessSystem": {
        "ClientId": "Host_BusinessSystem",
        "ClientSecret": "demo-business-system-secret"
      },
      "Host_Swagger": {
        "ClientId": "Host_Swagger",
        "RootUrl": "https://localhost:44352"
      }
    }
  }
}
