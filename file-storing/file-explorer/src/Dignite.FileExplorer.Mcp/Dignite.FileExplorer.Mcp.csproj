<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Dignite.FileExplorer.Mcp</AssemblyName>
    <PackageId>Dignite.FileExplorer.Mcp</PackageId>
    <RootNamespace />
    <Description>MCP tools for Dignite.FileExplorer: lets an AI client list the file containers a host exposes, browse directories and files, upload small files and rename, move or delete them - every call going through the File Explorer application services and their per-container authorization. Contributes to the application's MCP server through Dignite.Abp.AspNetCore.Mcp, under the file_explorer namespace.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tools call the application service contracts only, never Domain: they are another caller of
         the same services the HTTP API uses, not a second implementation of them. -->
    <ProjectReference Include="..\Dignite.FileExplorer.Application.Contracts\Dignite.FileExplorer.Application.Contracts.csproj" />
    <!-- The shared MCP server. Not a cross-module reference: aspnetcore-mcp/ carries no domain model. -->
    <ProjectReference Include="..\..\..\..\aspnetcore-mcp\src\Dignite.Abp.AspNetCore.Mcp\Dignite.Abp.AspNetCore.Mcp.csproj" />
  </ItemGroup>

</Project>
