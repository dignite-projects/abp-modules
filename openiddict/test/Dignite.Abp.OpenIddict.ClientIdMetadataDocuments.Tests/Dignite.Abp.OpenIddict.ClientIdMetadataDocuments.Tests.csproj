<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace />
    <!-- Program.cs is the WebApplicationFactory entry point; the test SDK must not generate a second one. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Volo.Abp.AspNetCore.TestBase" />
    <PackageReference Include="Volo.Abp.Autofac" />
    <!-- A real OpenIddict application store, as a host has: SQLite in memory. -->
    <PackageReference Include="Volo.Abp.OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dignite.Abp.OpenIddict.ClientIdMetadataDocuments\Dignite.Abp.OpenIddict.ClientIdMetadataDocuments.csproj" />
  </ItemGroup>

</Project>
